# .env.example - copy to .env and fill in. Relative paths are resolved from the project root.

# ---------------------------------------------------------------- Supabase / PostgreSQL
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase -> Project Settings -> Database -> Connection string (Session pooler, port 5432).
# URL-encode special characters in the password ('@' -> %40).
DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------- AWS IoT Core (MQTT over TLS)
AWS_IOT_ENDPOINT=<prefix>-ats.iot.<region>.amazonaws.com
AWS_IOT_PORT=8883
AWS_IOT_CA_PATH=backend/certs/AmazonRootCA1.pem
AWS_IOT_CERT_PATH=backend/certs/<id>-certificate.pem.crt
AWS_IOT_KEY_PATH=backend/certs/<id>-private.pem.key
AWS_IOT_CLIENT_ID=greenhouse-backend

SENSOR_TOPICS=sensor/co2,sensor/npk,sensor/soil-moisture
RELAY_TOPIC=action/relay

# ---------------------------------------------------------------- backend API
BACKEND_PORT=8000
CORS_ORIGINS=*
RELAY_API_KEY=
RELAY_MIN_INTERVAL_S=1.0

# ---------------------------------------------------------------- ngrok / frontend
NGROK_BACKEND_URL=https://<your-subdomain>.ngrok-free.app
VITE_API_URL=http://localhost:8000
VITE_RELAY_API_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
